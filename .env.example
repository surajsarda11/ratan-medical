# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only credentials for the daily pickup WhatsApp scheduler.
# Use a Supabase service_role key or a supported sb_secret_... key; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=generate-a-long-random-secret

# Meta WhatsApp Business Platform / Cloud API. Automatic delivery requires a verified sender
# and an approved template named pickup_ready_notification with four body placeholders:
# {{1}} customer name, {{2}} booking ID, {{3}} shop name, {{4}} available medicine summary.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PICKUP_TEMPLATE_NAME=pickup_ready_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
